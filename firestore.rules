rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Public-facing intake forms: anyone can create, nobody can edit/delete client-side.
    // Staff updates (status changes, assigning box numbers, etc.) go through the
    // Admin SDK or Firebase Console until an authenticated staff role exists.

    match /pickups/{id} {
      allow create: if request.resource.data.contactName is string
                    && request.resource.data.phone is string
                    && request.resource.data.weightKg is number;
      allow read: if true;
      allow update, delete: if false;
    }

    match /deliveries/{id} {
      allow create: if request.resource.data.requesterName is string
                    && request.resource.data.fromLocation is string
                    && request.resource.data.toLocation is string;
      allow read: if true;
      allow update, delete: if false;
    }

    match /poboxes/{id} {
      allow create: if request.resource.data.orgName is string
                    && request.resource.data.contactEmail is string;
      allow read: if true;
      allow update, delete: if false;
    }

    match /submissions/{id} {
      allow create: if request.resource.data.submitterName is string
                    && request.resource.data.type in ["tender", "job_application", "receipt"];
      allow read: if true;
      allow update, delete: if false;
    }

    match /exports/{id} {
      allow create: if request.resource.data.requesterName is string
                    && request.resource.data.goodsDescription is string;
      allow read: if true;
      allow update, delete: if false;
    }

    match /auctions/{id} {
      allow create: if request.resource.data.title is string
                    && request.resource.data.startingPriceRwf is number;
      allow read: if true;
      allow update, delete: if false;
    }

    match /trade_inquiries/{id} {
      allow create: if request.resource.data.companyName is string
                    && request.resource.data.contactEmail is string;
      allow read: if true;
      allow update, delete: if false;
    }

    match /shops/{id} {
      allow create: if request.resource.data.shopName is string
                    && request.resource.data.phone is string;
      allow read: if true;
      allow update, delete: if false;
    }

    // Kashi applications contain partial ID data — readable only via the
    // Admin SDK (staff review), never directly by clients.
    match /kashi_applications/{id} {
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.idReference is string
                    && request.resource.data.idReference.size() <= 4;
      allow read, update, delete: if false;
    }

    // Shipments: read-only to the public (tracking lookups); staff/integration writes only.
    match /shipments/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}
