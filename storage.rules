rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function staff(){return request.auth != null && request.auth.token.get('staff',false) == true;}
  match /serviceDocuments/{uid}/{requestId}/document {
   allow read: if request.auth != null && (request.auth.uid == uid || staff());
   allow create: if request.auth != null && request.auth.uid == uid
    && !firestore.exists(/databases/(default)/documents/service_requests/$(requestId))
    && request.resource.size > 0 && request.resource.size <= 10485760
    && request.resource.contentType in ['application/pdf','image/jpeg','image/png'];
   allow delete: if request.auth != null && request.auth.uid == uid
    && !firestore.exists(/databases/(default)/documents/service_requests/$(requestId));
  }
  match /{allPaths=**} {allow read, write: if false;}
 }
}
