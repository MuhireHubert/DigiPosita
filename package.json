{
  "name": "digiposita",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "staff": "tsx scripts/staff.ts",
    "test:rules": "firebase emulators:exec --project demo-digiposita --only firestore \"node --test tests/firestore.test.mjs\"",
    "emulators": "firebase emulators:start --project demo-digiposita --only auth,firestore",
    "test:browser": "playwright test",
    "format:check": "prettier --check \"app/**/*.{tsx,css}\" \"components/*.tsx\" \"lib/*.ts\" \"scripts/*.ts\" \"tests/**/*.{ts,mjs}\" playwright.config.ts next.config.js package.json firebase.json firestore.indexes.json README.md"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "next": "^15.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "3.4.6",
    "tsx": "^4.23.15",
    "typescript": "5.5.4"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "source-map-js": "^1.2.2",
    "postcss": "$postcss"
  }
}
